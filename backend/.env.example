# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/swiggy_auth_db

# JWT Secret Keys
JWT_SECRET=production_jwt_super_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
REGISTRATION_TOKEN_SECRET=registration_temp_token_secret_key_change_in_production
REGISTRATION_TOKEN_EXPIRES_IN=15m

# Twilio Credentials (Production OTP)
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Dual Mode Twilio Support:
# Option 1 (Recommended): Twilio Verify Service SID (e.g., VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX)
# Twilio Verify handles OTP generation, localized SMS delivery, auto-expiry, and carrier anti-fraud.
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Option 2 (Fallback): Programmable SMS Twilio Phone Number in E.164 format (e.g., +1234567890)
# Used if TWILIO_VERIFY_SERVICE_SID is not set.
TWILIO_PHONE_NUMBER=+1234567890

# Application-Layer Field-Level Encryption
FIELD_ENCRYPTION_KEY=your_256_bit_hex_key_here

# Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="MedSafe Health Alerts" <your_email@gmail.com>

